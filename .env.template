# Environment Variables Template
# For production deployment, set these as environment variables
# Never commit actual credentials to version control!

# Database Configuration
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_NAME=corporate_kb
DB_USERNAME=your_username
DB_PASSWORD=your_password

# For JDBC URL construction:
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JPA Settings for Production
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Logging Level
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_INFOSYS_AI=INFO

# File Upload Limits (in MB)
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# Vector Configuration
VECTOR_DIMENSION=768
VECTOR_CHUNK_SIZE=500
VECTOR_CHUNK_OVERLAP=50

# Gemini Configuration
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Usage Example for Different Platforms:

# Heroku:
# heroku config:set GEMINI_API_KEY=your_key

# Azure App Service:
# az webapp config appsettings set --settings GEMINI_API_KEY=your_key

# AWS Elastic Beanstalk:
# eb setenv GEMINI_API_KEY=your_key

# Docker:
# docker run -e GEMINI_API_KEY=your_key ...

# Kubernetes:
# Create a Secret and mount as env vars in deployment.yaml
